# ═══════════════════════════════════════════════
# EC2 Control Portal — Deployment Configuration
# Copy this file to deploy-config.env and fill in your values.
# deploy-config.env is gitignored — never commit it.
# ═══════════════════════════════════════════════

# Email of the first admin user (receives Cognito temporary password via email)
ADMIN_EMAIL=you@example.com

# Unique prefix for the Cognito hosted login URL — must be globally unique across all AWS accounts
# Final URL will be: https://<prefix>.auth.<region>.amazoncognito.com
# Use lowercase letters, numbers, and hyphens only. Example: mycompany-ec2-ctrl
COGNITO_DOMAIN_PREFIX=your-unique-prefix

# Deployment environment label (used in resource names)
ENVIRONMENT=production

# AWS CLI named profile to use for this deployment
# Run: aws configure --profile <name>  to create a profile
# Leave blank to use the default AWS CLI credentials
AWS_PROFILE=

# AWS region for the main stack (e.g. ap-south-1, us-east-1, eu-west-1)
AWS_REGION=ap-south-1

# Email to receive idle auto-stop notifications (M4 feature)
# Leave blank to disable SNS alerts
NOTIFICATION_EMAIL=you@example.com

# ─── Custom Domain (optional) ───────────────────────────────────────────────
# Set all three values below to serve the portal on your own subdomain.
# Leave all three blank to use the auto-generated CloudFront domain instead.

# Your portal subdomain (e.g. portal.yourdomain.com)
CUSTOM_DOMAIN=

# ACM Certificate ARN — MUST be issued in us-east-1 (CloudFront requirement)
# To create: deploy cloudformation/acm-cert-stack.yaml to us-east-1, then paste the output ARN here.
# Example: arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ACM_CERT_ARN=

# Route 53 Hosted Zone ID for your domain
# Find it: AWS Console → Route 53 → Hosted zones → click your domain → Hosted zone ID
# Example: Z1PA6795UKMFR9
HOSTED_ZONE_ID=
