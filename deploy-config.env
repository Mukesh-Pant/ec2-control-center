# ═══════════════════════════════════════════════
# EC2 Control Portal — Deployment Configuration
# Fill in these values before running deploy.sh
# ═══════════════════════════════════════════════

# Email of the first admin user (receives Cognito invite)
ADMIN_EMAIL=pantm8877@gmail.com

# Unique prefix for Cognito login URL (lowercase, hyphens only, globally unique)
# Example: mycompany-ec2-control
COGNITO_DOMAIN_PREFIX=ocu-ec2-ctrl-v2

# Deployment environment
ENVIRONMENT=production

# AWS region for the central stack
AWS_REGION=ap-south-1

# Email to receive idle auto-stop notifications (M4)
# Leave blank to disable SNS notifications
NOTIFICATION_EMAIL=pantm8877@gmail.com
