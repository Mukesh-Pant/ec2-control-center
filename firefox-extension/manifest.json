{
  "manifest_version": 3,
  "name": "EC2 Control — Console Login",
  "version": "1.1.0",
  "description": "Opens AWS Console sessions in isolated Firefox containers for the EC2 Control portal (solobil.com).",
  "browser_specific_settings": {
    "gecko": {
      "id": "ec2ctrl@solobil.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://solobil.com/*",
    "https://www.solobil.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://solobil.com/*", "https://www.solobil.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
